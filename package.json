{
  "name": "@okam/core",
  "version": "0.0.0",
  "private": true,
  "description": "Okam Core — client-side models and core logic, vendored as source into every consumer app.",
  "type": "module",
  "exports": {
    "./consumer/c0": "./consumer/c0/index.ts",
    "./consumer/c0/domain": "./consumer/c0/domain/index.ts",
    "./consumer/c0/contracts": "./consumer/c0/contracts/index.ts",
    "./consumer/c0/application": "./consumer/c0/application/index.ts",
    "./consumer/c0/application/v1": "./consumer/c0/application/v1/index.ts",
    "./consumer/c0/ports": "./consumer/c0/ports/index.ts",
    "./consumer/c0/domain/v1": "./consumer/c0/domain/v1/index.ts",
    "./consumer/adapters/state": "./consumer/adapters/state/index.ts",
    "./consumer/adapters/react": "./consumer/adapters/react/index.ts",
    "./package.json": "./package.json",
    "./*": "./*"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck:consumer-c0": "tsc -p tsconfig.consumer-c0.json",
    "typecheck:consumer-adapters": "tsc -p tsconfig.consumer-adapters.json",
    "typecheck:consumer-package": "tsc -p tsconfig.consumer-package.json",
    "guard:consumer-c0": "vitest run tests/consumer-c0-boundaries.test.ts",
    "guard:consumer-adapters": "vitest run tests/consumer-state-adapters.test.ts"
  },
  "dependencies": {
    "zustand": "5.0.14"
  },
  "peerDependencies": {
    "react": ">=18.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "19.2.17",
    "typescript": "^5.7.0",
    "vitest": "^2.1.9"
  }
}
